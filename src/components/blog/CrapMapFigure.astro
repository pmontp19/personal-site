---
// CRAP = c² × (1 - cob)³ + c. Bandes de l'eina de l'Uncle Bob: ≤5 net, ≤30 moderat, >30 crappy.
const C0 = 1;
const C1 = 20;
const X0 = 80;
const X1 = 700;
const Y0 = 560; // cobertura 0%
const Y1 = 80; // cobertura 100%
const sx = (c: number) => X0 + ((c - C0) / (C1 - C0)) * (X1 - X0);
const sy = (cov: number) => Y0 - cov * (Y0 - Y1);
// Cobertura mínima perquè una funció de complexitat c no passi de `limit`.
const covFor = (c: number, limit: number) =>
  Math.min(1, Math.max(0, 1 - Math.cbrt(Math.max(0, limit - c) / (c * c))));
const curve = (from: number, to: number, limit: number) => {
  const pts: string[] = [];
  for (let k = 0; k <= 60; k++) {
    const c = from + ((to - from) * k) / 60;
    pts.push(`${sx(c).toFixed(1)} ${sy(covFor(c, limit)).toFixed(1)}`);
  }
  return pts;
};
const crappy = `M${curve(5, C1, 30).join("L")}L${sx(C1)} ${Y0}L${sx(5)} ${Y0}Z`;
const clean = `M${sx(C0)} ${Y0}L${curve(1, 5, 5).join("L")}L${sx(C0)} ${Y1}Z`;

const useCase = { c: 12, cov: 0.89 };
const shutdown = { c: 7, cov: 0 };
const ux = sx(useCase.c);
const uy = sy(useCase.cov);
const ring = Array.from({ length: 11 }, (_, k) => {
  const a = (k / 11) * Math.PI * 2 - Math.PI / 2;
  return [ux + Math.cos(a) * 30, uy + Math.sin(a) * 30];
});
---

<figure class="fig">
  <svg viewBox="0 0 720 660" role="img" aria-labelledby="fig-crap-title">
    <title id="fig-crap-title">
      Mapa del CRAP: complexitat a l'eix horitzontal, cobertura al vertical,
      amb les bandes net, moderat i crappy. Una funció sense tests i
      complexitat 7 cau a la zona crappy. Una altra, de complexitat 12 i
      cobertura 89%, surt moderada, però l'envolten onze mutants que
      sobreviuen
    </title>

    <text class="ac b" x="0" y="34">
      COBERTURA
    </text>
    <rect class="tint" x={X0} y={Y1} width={X1 - X0} height={Y0 - Y1} />
    <path class="tint-2" d={crappy} />
    <path style="fill:var(--bg)" d={clean} />

    {[0, 0.5, 1].map((v) => (
      <>
        <line class="grid" x1={X0} x2={X1} y1={sy(v)} y2={sy(v)} />
        <text x={X0 - 14} y={sy(v) + 9} text-anchor="end">{`${v * 100}%`}</text>
      </>
    ))}
    {[1, 5, 10, 15, 20].map((c) => (
      <text x={sx(c)} y={Y0 + 40} text-anchor="middle">
        {c}
      </text>
    ))}
    <text class="ac b" x={X1} y={Y0 + 84} text-anchor="end">
      COMPLEXITAT →
    </text>

    <text class="fg b" x={X0 + 16} y={Y1 + 40}>
      NET
    </text>
    <text class="fg b" x={sx(6)} y={sy(0.5)}>
      MODERAT
    </text>
    <text class="fg b" x={X1 - 16} y={Y0 - 24} text-anchor="end">
      CRAPPY
    </text>

    <circle class="ac" cx={sx(shutdown.c)} cy={sy(shutdown.cov)} r="9" />

    {ring.map(([x, y]) => (
      <circle class="ln-ac" style="stroke-width:2.5" cx={x} cy={y} r="6" />
    ))}
    <circle class="fg" cx={ux} cy={uy} r="9" />
  </svg>
</figure>
