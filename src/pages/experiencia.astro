---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Lifeline from "../components/Lifeline.astro";
import { formatDate } from "../utils/date";

const experiences = (await getCollection("experience")).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);

const fmt = (d: Date, yearOnly?: boolean) =>
  formatDate(
    d,
    yearOnly ? { year: "numeric" } : { month: "long", year: "numeric" },
    "ca-ES",
  );
---

<Layout
  title="Experiència | Pere Montpeó"
  description="Trajectòria professional de Pere Montpeó, enginyer de programari."
  canonicalUrl="https://peremontpeo.dev/experiencia/"
>
  <h1 class="title page-title">EXPERIÈNCIA</h1>
  <a class="mdlink" href="/cv/ca">
    veure el CV clàssic →
  </a>

  <p class="tilde" aria-hidden="true">
    ~~~
  </p>

  <Lifeline />

  <p class="tilde" aria-hidden="true">
    ~~~
  </p>

  {experiences.map(({ data }) => (
    <article class="exp-entry">
      <p class="exp-head">
        <span class="title">{data.ca.role}</span>
        <span class="muted"> @ </span>
        <span class="accent">{data.company}</span>
      </p>
      <p class="exp-date muted">
        {fmt(data.startDate, data.yearOnly)} –{" "}
        {data.endDate ? fmt(data.endDate, data.yearOnly) : "Actual"} ·{" "}
        {data.ca.location}
      </p>

      <ul class="exp-bullets">
        {data.ca.bullets.map((b) => (
          <li>{b}</li>
        ))}
      </ul>

      {data.tags && data.tags.length > 0 && (
        <p class="exp-tags muted">{data.tags.join(" · ")}</p>
      )}

      <p class="tilde" aria-hidden="true">
        ~~~
      </p>
    </article>
  ))}
</Layout>

<style>
  .page-title {
    font-size: 1.4rem;
    margin: 0 0 0.5rem;
    text-transform: uppercase;
  }

  .exp-entry {
    margin: 0;
  }
  .exp-head {
    margin: 0;
  }
  .exp-date {
    margin: 0 0 0.5rem;
    font-variant-numeric: tabular-nums;
  }
  /* llista estil markdown: "- " muted amb sagnat penjant */
  .exp-bullets {
    max-width: 64ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .exp-bullets li {
    padding-left: 2ch;
    text-indent: -2ch;
    margin-bottom: 0.35rem;
  }
  .exp-bullets li::before {
    content: "- ";
    color: var(--muted);
  }
  .exp-tags {
    margin: 0.5rem 0 0;
  }
</style>
