---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { calculateReadingTime } from "../../utils/readingTime";
import { getSlug } from "../../utils/date";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries
    .filter((entry) => entry.data.draft !== true)
    .map((entry) => ({
      params: { slug: getSlug(entry.id) },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
// ponytail: only h2, shown from 4 sections up
const toc = headings.filter((h) => h.depth === 2);
const slug = getSlug(entry.id);

const contentForReadingTime = entry.body || entry.data.description || "";
const readingTime = calculateReadingTime(contentForReadingTime);

const siteUrl = "https://peremontpeo.dev";
const pageUrl = `${siteUrl}/blog/${slug}/`;
const ogImageUrl = `${siteUrl}/api/og-image/${slug}.png`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  dateModified:
    entry.data.lastUpdated?.toISOString() ?? entry.data.date.toISOString(),
  author: { "@type": "Person", name: "Pere Montpeó", url: siteUrl },
  publisher: { "@type": "Person", name: "Pere Montpeó", url: siteUrl },
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  image: entry.data.image ? `${siteUrl}${entry.data.image.src}` : ogImageUrl,
};

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat("ca-ES", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
}
---

<Layout
  title={`${entry.data.title} | Pere Montpeó`}
  description={entry.data.description}
  canonicalUrl={pageUrl}
  jsonLd={articleSchema}
  ogImage={ogImageUrl}
  ogType="article"
>
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={entry.data.date.toISOString()}
    />
    {entry.data.lastUpdated && (
      <meta
        property="article:modified_time"
        content={entry.data.lastUpdated.toISOString()}
      />
    )}
    <meta property="article:author" content="Pere Montpeó" />
  </Fragment>

  <article class="post">
    <a href="/blog" class="mdlink back">
      ← tornar als apunts
    </a>
    <h1 class="post-title title">{entry.data.title}</h1>
    <p class="post-meta muted">
      <time datetime={entry.data.date.toISOString()}>
        {formatDate(entry.data.date)}
      </time>
      {entry.data.lastUpdated && (
        <span> · actualitzat {formatDate(entry.data.lastUpdated)}</span>
      )}
      <span> · {readingTime}</span>
    </p>

    {entry.data.image && (
      <div class="hero-image">
        <Image
          src={entry.data.image}
          alt={entry.data.imageAlt || entry.data.title}
          widths={[400, 800, 1200]}
          sizes="(max-width: 46rem) 100vw, 46rem"
        />
      </div>
    )}

    <p class="tilde" aria-hidden="true">
      ~~~
    </p>

    {toc.length >= 4 && (
      <>
        <nav class="toc-ticks" aria-label="Contingut">
          <ul>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>
                  <span class="t">{h.text}</span>
                  <span class="k" />
                </a>
              </li>
            ))}
          </ul>
          <div class="card" aria-hidden="true">
            <span class="ct" />
            <span class="cx" />
          </div>
        </nav>
        <div class="toc-bar">
          <div class="menu" id="toc-menu">
            {toc.map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
          </div>
          <button
            type="button"
            class="bar"
            aria-expanded="false"
            aria-controls="toc-menu"
            aria-label="Contingut de l'article"
          >
            <span class="fill" />
          </button>
        </div>
      </>
    )}

    <div class="post-content prose">
      <Content />
    </div>

    <p class="tilde" aria-hidden="true">
      ~~~
    </p>

    <footer class="post-footer">
      <a href="/blog" class="mdlink">
        ← tots els apunts
      </a>
      <span class="muted share">
        compartir:
        <a
          class="mdlink"
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(pageUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          twitter
        </a>
        <a
          class="mdlink"
          href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(pageUrl)}&title=${encodeURIComponent(entry.data.title)}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          linkedin
        </a>
      </span>
    </footer>
  </article>
</Layout>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>(
    ".toc-ticks a, .toc-bar .menu a",
  );
  if (links.length) {
    const id = (a: HTMLAnchorElement) => decodeURIComponent(a.hash.slice(1));
    const heads = [
      ...document.querySelectorAll<HTMLAnchorElement>(".toc-ticks a"),
    ].map((a) => document.getElementById(id(a)));
    const post = document.querySelector<HTMLElement>(".post-content")!;
    const fill = document.querySelector<HTMLElement>(".toc-bar .fill")!;
    const bar = document.querySelector<HTMLElement>(".toc-bar")!;
    const button = bar.querySelector("button")!;
    const BLOCKS = 12;
    let ticking = false;

    const update = () => {
      ticking = false;
      const top = post.offsetTop;
      const end = top + post.offsetHeight - innerHeight;
      const p = Math.min(
        1,
        Math.max(0, (scrollY - top) / Math.max(1, end - top)),
      );
      const f = Math.round(p * BLOCKS);
      fill.textContent = "█".repeat(f) + "░".repeat(BLOCKS - f);
      let cur = -1;
      heads.forEach((h, i) => {
        if (h && h.getBoundingClientRect().top <= innerHeight * 0.35) cur = i;
      });
      links.forEach((a) => {
        const i = heads.findIndex((h) => h?.id === id(a));
        a.toggleAttribute("data-current", i === cur);
        a.toggleAttribute("data-done", i < cur);
        if (i === cur) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      });
    };
    const nav = document.querySelector<HTMLElement>(".toc-ticks")!;
    const rows = [...nav.querySelectorAll<HTMLAnchorElement>("a")];
    const ct = nav.querySelector<HTMLElement>(".ct")!;
    const cx = nav.querySelector<HTMLElement>(".cx")!;
    const excerpt = (h: HTMLElement | null) => {
      let el = h?.nextElementSibling;
      while (el && !el.textContent?.trim() && !/^H[1-6]$/.test(el.tagName))
        el = el.nextElementSibling;
      return el && !/^H[1-6]$/.test(el.tagName)
        ? (el.textContent ?? "").replace(/\s+/g, " ").trim()
        : "";
    };
    const hover = (i: number | null) => {
      rows.forEach((a, j) => {
        if (i === null) a.removeAttribute("data-d");
        else a.dataset.d = String(Math.min(3, Math.abs(j - i)));
      });
      nav.toggleAttribute("data-active", i !== null);
      if (i === null) return;
      ct.textContent = rows[i].querySelector(".t")!.textContent;
      cx.textContent = excerpt(heads[i]);
      nav.style.setProperty(
        "--cy",
        `${rows[i].offsetTop + rows[i].offsetHeight / 2}px`,
      );
    };
    nav.addEventListener("pointermove", (e) => {
      const i = rows.findIndex((a) => {
        const r = a.getBoundingClientRect();
        return e.clientY >= r.top && e.clientY < r.bottom;
      });
      if (i >= 0 || !(e.target as Element).closest(".card"))
        hover(i < 0 ? null : i);
    });
    nav.addEventListener("pointerleave", () => hover(null));
    nav.addEventListener("focusin", (e) =>
      hover(rows.indexOf((e.target as Element).closest("a")!)),
    );
    nav.addEventListener("focusout", () => hover(null));
    const setOpen = (open: boolean) => {
      bar.toggleAttribute("data-open", open);
      button.setAttribute("aria-expanded", String(open));
    };

    addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    addEventListener("resize", update);
    button.addEventListener("click", () =>
      setOpen(!bar.hasAttribute("data-open")),
    );
    addEventListener("click", (e) => {
      if (!bar.contains(e.target as Node)) setOpen(false);
    });
    addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
    bar
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", () => setOpen(false)));
    update();
  }
</script>

<style>
  .post {
    margin: 0 auto;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .post-title {
    font-size: 1.6rem;
    line-height: 1.2;
    margin: 0 0 0.5rem;
    text-wrap: balance;
  }

  .post-meta {
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .hero-image {
    margin: 1.5rem 0 0;
  }
  .hero-image :global(img) {
    width: 100%;
    height: auto;
  }

  /* --- cos de l'article: Geist Sans (excepció de prosa) --- */
  .post-content {
    font-size: 1.0625rem;
    max-width: 42rem;
  }
  .post-content :global(h2) {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
  }
  .post-content :global(h3) {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
  }
  .post-content :global(p) {
    margin: 0 0 1.15rem;
  }
  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.15rem;
    padding-left: 1.5rem;
  }
  .post-content :global(li) {
    margin-bottom: 0.4rem;
  }
  .post-content :global(pre) {
    background-color: var(--surface);
    padding: 1rem;
    margin: 1.5rem 0;
    overflow-x: auto;
    border: 1px solid var(--line);
  }
  .post-content :global(code) {
    font-family: var(--mono);
    font-size: 0.85em;
  }
  .post-content :global(:not(pre) > code) {
    background-color: var(--surface);
    padding: 0.1em 0.35em;
  }
  .post-content :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    color: var(--muted);
    margin: 1.5rem 0;
  }
  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    margin: 1.5rem 0;
  }
  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }
  .post-content :global(table th),
  .post-content :global(table td) {
    padding: 0.5rem;
    border: 1px solid var(--line);
    text-align: left;
  }
  .post-content :global(.external-link-icon-wrapper) {
    white-space: nowrap;
    margin-left: 0.25em;
  }
  .post-content :global(.external-link-icon) {
    display: inline-block;
    width: 0.85em;
    height: 0.85em;
    vertical-align: -0.1em;
  }

  /* --- toc: tics al marge (>=1000px), barra flotant (mòbil) --- */
  .toc-ticks {
    position: fixed;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
  }
  .toc-ticks ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-ticks a {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    height: 22px;
    color: var(--muted);
    text-decoration: none;
  }
  .toc-ticks .t {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .toc-ticks .k {
    width: 24px;
    height: 2px;
    border-radius: 1px;
    background: var(--muted);
    opacity: 0.5;
    transform-origin: right;
    transform: scaleX(0.5);
    transition:
      transform 0.15s,
      opacity 0.15s;
  }
  .toc-ticks a[data-d="0"] .k {
    transform: none;
    opacity: 0.9;
  }
  .toc-ticks a[data-d="1"] .k {
    transform: scaleX(0.667);
  }
  .toc-ticks a[data-d="2"] .k {
    transform: scaleX(0.417);
  }
  .toc-ticks .card {
    position: absolute;
    right: calc(100% + 12px);
    top: var(--cy, 0);
    width: 20rem;
    padding: 12px;
    transform: translateY(-50%);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.25);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.15s,
      visibility 0s 0.15s;
  }
  .toc-ticks[data-active] .card {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .toc-ticks .ct {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--fg);
    font-weight: 500;
  }
  .toc-ticks .cx {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin-top: 4px;
    color: var(--muted);
  }
  .toc-ticks a[data-done] .k {
    background: var(--fg);
    opacity: 1;
  }
  .toc-ticks a[data-current] {
    color: var(--accent);
  }
  .toc-ticks a[data-current] .k {
    background: var(--accent);
    opacity: 1;
  }

  .toc-bar {
    display: none;
    position: fixed;
    left: 50%;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    z-index: 5;
  }
  .toc-bar .bar {
    display: block;
    font: inherit;
    letter-spacing: -0.05em;
    color: var(--accent);
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 12px 16px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.12s ease-out;
  }
  .toc-bar .bar:active {
    transform: scale(0.96);
  }
  .toc-bar .menu {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    width: min(20rem, calc(100vw - 32px));
    padding: 6px 0;
    max-height: 60dvh;
    overflow-y: auto;
    background: var(--bg);
    border: 1px solid var(--line);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 8px) scale(0.97);
    transform-origin: 50% 100%;
    transition:
      opacity 0.16s ease-out,
      transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s 0.2s;
  }
  .toc-bar[data-open] .menu {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0) scale(1);
    transition-delay: 0s;
  }
  .toc-bar .menu a {
    display: block;
    padding: 9px 16px;
    color: var(--muted);
    text-decoration: none;
  }
  .toc-bar .menu a[data-current] {
    color: var(--accent);
  }

  @media (max-width: 999px) {
    .toc-ticks {
      display: none;
    }
    .toc-bar {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .toc-ticks *,
    .toc-bar * {
      transition: none !important;
    }
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  .share {
    display: inline-flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
</style>
